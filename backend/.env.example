PROD_LLM_MODEL_1=gpt-4o-mini
PROD_LLM_MODEL_2=gpt-4o

PROD_EMBED_MODEL_1=text-embedding-3-small 
PROD_EMBED_MODEL_2=text-embedding-3-large 

