# APPLICATION ENVIRONMENT
APP_ENV=dev

APP_URL=http://localhost:5173

# Server Config
PORT=8000
HOST=0.0.0.0

# Development
OLLAMA_BASE_URL=http://localhost:11434

DEV_LLM_MODEL_1=gemma4:31b-cloud
DEV_LLM_MODEL_2=gemma4:31b-cloud

